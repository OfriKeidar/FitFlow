# Copy this file to .env and fill in the values. .env is ignored by git - never commit secrets.

# The AI coach needs ONE of these. Gemini has a free tier: get a key at https://aistudio.google.com
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Optional: force a provider (gemini / anthropic / openai-compatible) and a model
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-flash-latest
# For openai-compatible (Groq, OpenRouter, Ollama...): LLM_BASE_URL, LLM_MODEL, LLM_API_KEY

# Any long random string. Required in production; a development default is used when empty.
JWT_SECRET=
# Optional: PostgreSQL instead of the local SQLite file.
# DATABASE_URL=postgresql://user:password@localhost:5432/fitflow
